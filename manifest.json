{
  "manifest_version": 3,
  "name": "Ficha RUC · Perú Sistemas Pro",
  "short_name": "Ficha RUC",
  "version": "0.1.0",
  "description": "Selecciona un RUC en cualquier página y mira su ficha pública al costado: estado, condición, distrito y alertas de riesgo.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://club.perusistemas.pro/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "action": {
    "default_title": "Ficha RUC",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
